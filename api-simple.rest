## 2. [user] section
### 2.1 POST api/auth/local [login]
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.2 POST api/auth/local/register [register]
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
  "username" : "newuser",
  "email" : "newemail@example.com",
  "password" : "newpassword"
}

### 2.3 POST api/auth/forgot-password [forgot password]
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email" : "{{userEmail}}"
}

### 2.3.1 POST api/auth/reset-password [reset password]
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "code" : "{{resetPasswordUserToken}}",
  "password" : "{{newPasswordUser}}",
  "passwordConfirmation" : "{{newPasswordUser}}"
}


### 2.4 GET api/users/me [get profile]
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userToken}}