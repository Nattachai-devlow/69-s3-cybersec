# ===== PostgreSQL =====
POSTGRES_USER=change-me@example.com
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_20chars+
POSTGRES_DB=change-me-db

# ===== pgAdmin =====
PGADMIN_DEFAULT_EMAIL=change-me@pgadmin4.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_20chars+

# ===== ports / host =====
BIND_IP=127.0.0.1
MY_LOCALHOST=db
DATABASE_PORT=5433
DATABASE_PORT_APP=5432
DATABASE_CLIENT=postgres
APP_PORT=8037
PGADMIN_PORT=8000

# ===== Strapi secrets (ใช้ค่าจากคำสั่ง gen ด้านบน) =====
APP_KEYS=<key1>,<key2>,<key3>,<key4>
API_TOKEN_SALT=<random_hex>
ADMIN_JWT_SECRET=<random_hex>
TRANSFER_TOKEN_SALT=<random_hex>
JWT_SECRET=<random_hex>

# ===== SMTP (อีเมล forgot/reset password) =====
# หมายเหตุ: ค่าเริ่มต้นด้านล่างสำหรับ Mailhog (dev ในเครื่องเท่านั้น)
# Production ต้องใช้ SMTP จริง + SMTP_REQUIRE_TLS=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_REJECT_UNAUTHORIZED=false
SMTP_FROM=no-reply@test.com

# สำหรับ value ในการใช้ยิง API ของ .rest จะเก็บ value แยกกับ .env ซึ่งเก็บไว้ในไฟล์ .vscode/settings.json (ไม่ commit) 
# และ .vscode/settings-simple.json (commit ได้) เพื่อให้ VSCode REST Client อ่านค่า {{...}} แทนค่าจริงจาก settings.json